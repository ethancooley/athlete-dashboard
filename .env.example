# Required
DASH_PASSWORD=choose-a-long-passphrase
SESSION_SECRET=run: openssl rand -hex 32

# Data source. Server-side only; never prefix with NEXT_PUBLIC_
ATHLETEDATA_MCP_URL=
ATHLETEDATA_MCP_TOKEN=            # only if your provider gives a bearer token separately from the URL

# Global settings as a JSON string (title, timezone, history start, footer). Optional.
# See config/athlete.config.example.json. Self-hosting? Put it in config/athlete.config.json instead.
# Events, goals and plans live in the database, per block: see config/import.example.json and the Admin page.
ATHLETE_CONFIG=

# Demo mode: synthetic data, no data source needed
MOCK=0

# History and Records. On Vercel, connecting a Neon database sets DATABASE_URL for you.
DATABASE_URL=
# Authorizes the nightly Vercel Cron call to /api/cron/sync (any long random string)
CRON_SECRET=
