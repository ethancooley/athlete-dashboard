# Required
DASH_PASSWORD=choose-a-long-passphrase
SESSION_SECRET=run: openssl rand -hex 32

# Data source. Server-side only; never prefix with NEXT_PUBLIC_
ATHLETEDATA_MCP_URL=
ATHLETEDATA_MCP_TOKEN=            # only if your provider gives a bearer token separately from the URL

# Your event, goal, thresholds and plan (JSON strings). Optional: without them the app shows a generated sample plan.
# See config/athlete.config.example.json and config/plan.example.json. Self-hosting? Put them in config/*.json instead.
ATHLETE_CONFIG=
PLAN_JSON=

# Demo mode: synthetic data, no data source needed
MOCK=0
